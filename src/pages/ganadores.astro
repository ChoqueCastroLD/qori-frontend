---
import Layout from "../layouts/Layout.astro";
import RaffleCard from "../components/RaffleCard.astro";
import Icon from "../components/Icon.astro";
import { ssrGet, type Raffle } from "../lib/api";

const raffles = await ssrGet<Raffle[]>("/raffles", []);
const winners = raffles
  .filter((r) => r.status === "DRAWN")
  .sort((a, b) => new Date(b.drawnAt ?? 0).getTime() - new Date(a.drawnAt ?? 0).getTime());
const totalPrize = winners.reduce((s, r) => s + (r.prizeValue ?? 0), 0);
---

<Layout title="Ganadores · qori" description="Los que ya se llevaron su premio en qori. Cada sorteo con su ganador, la grabación y los datos para revisarlo tú mismo.">
  <div class="mx-auto max-w-6xl px-5 py-10 sm:py-12">
    <div class="flex items-center gap-2 text-emerald-700">
      <Icon name="trophy" class="h-5 w-5" />
      <span class="text-sm font-semibold uppercase tracking-wide">Ganadores</span>
    </div>
    <h1 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl">Los que ya se llevaron su premio</h1>
    <p class="mt-3 max-w-2xl text-slate-500">
      Cada sorteo se hizo en vivo y con datos públicos. Entra a cualquiera para ver al ganador y revisar el resultado tú mismo.
    </p>

    {winners.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-3">
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-2xl font-bold text-slate-900">{winners.length}</div>
          <div class="text-xs text-slate-500">premios entregados</div>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white px-4 py-3">
          <div class="text-2xl font-bold text-emerald-700" data-usd={(totalPrize / 100).toFixed(2)}>${(totalPrize / 100).toLocaleString("en-US")}</div>
          <div class="text-xs text-slate-500">en premios</div>
        </div>
      </div>
    )}

    {winners.length === 0 ? (
      <div class="mt-10 rounded-2xl border border-dashed border-slate-200 p-10 text-center sm:p-14">
        <p class="mx-auto max-w-md text-slate-500">
          Aquí verás a cada ganador, la grabación y los datos para revisarlo. Y si tienes un ticket, aquí puede aparecer tu nombre.
        </p>
        <a href="/sorteos" class="mt-5 inline-flex items-center gap-1 rounded-xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white hover:bg-slate-700">
          Ver sorteos activos <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    ) : (
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {winners.map((r) => <RaffleCard raffle={r} />)}
      </div>
    )}
  </div>
</Layout>
