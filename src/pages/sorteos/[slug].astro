---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import BuyWidget from "../../components/BuyWidget.tsx";
import { ssrGet, type Raffle } from "../../lib/api";
import { lingotes, usd, pct, timeLeft, GAME_LABEL } from "../../lib/format";

const GAME_DESC: Record<string, string> = {
  ELIMINATION: "Se eliminan tickets al azar, uno por uno, hasta quedar el ganador.",
  DIGIT_REVEAL: "Se descubren los dígitos del número ganador uno a uno.",
  SQUID: "Estilo luz roja / luz verde: en cada luz roja se elimina un grupo de tickets.",
  HORSE_RACE: "Los tickets avanzan como en una carrera; los que quedan atrás salen.",
  BOMBS: "Caen bombas que explotan tickets por fases hasta llegar al ganador.",
};

const { slug } = Astro.params;
const r = await ssrGet<Raffle | null>(`/raffles/${slug}`, null);
if (!r) return Astro.redirect("/sorteos");

const sold = r.ticketsSold ?? 0;
const isDrawn = r.status === "DRAWN";
const isOpen = r.status === "OPEN";

// Country flags served from /public/flags (real SVGs, not emoji).
const ZONES = [
  { cc: "pe", name: "Perú", tz: "America/Lima" },
  { cc: "mx", name: "México", tz: "America/Mexico_City" },
  { cc: "co", name: "Colombia", tz: "America/Bogota" },
  { cc: "cl", name: "Chile", tz: "America/Santiago" },
  { cc: "ar", name: "Argentina", tz: "America/Argentina/Buenos_Aires" },
  { cc: "ec", name: "Ecuador", tz: "America/Guayaquil" },
  { cc: "bo", name: "Bolivia", tz: "America/La_Paz" },
  { cc: "ve", name: "Venezuela", tz: "America/Caracas" },
];
const zoneTime = (iso: string, tz: string) =>
  new Intl.DateTimeFormat("es", { timeZone: tz, weekday: "short", day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" }).format(new Date(iso));
const fmtLog = (iso: string, tz = "America/Lima") =>
  new Intl.DateTimeFormat("es", { timeZone: tz, day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" }).format(new Date(iso));
const exts = Array.isArray(r.extensions) ? r.extensions : [];
const partData = await ssrGet<any>(`/raffles/${slug}/participants`, { participants: [], totalTickets: 0 });
const participants = partData.participants ?? [];
const partTotal = partData.totalTickets ?? 0;
---

<Layout title={`${r.title} · qori`} description={r.description}>
  <div class="mx-auto max-w-6xl px-5 py-10">
    <a href="/sorteos" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-900">
      <Icon name="arrow-right" class="h-4 w-4 rotate-180" /> Volver a sorteos
    </a>

    <div class="mt-4 grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <!-- Left -->
      <div>
        <div class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-100">
          <img src={r.images[0]} alt={r.title} class="aspect-[3/2] w-full object-cover" />
        </div>
        {r.images.length > 1 && (
          <div class="mt-3 grid grid-cols-4 gap-3">
            {r.images.slice(0, 4).map((img) => (
              <img src={img} alt="" class="aspect-square w-full rounded-lg border border-slate-200 object-cover" />
            ))}
          </div>
        )}

        <h1 class="mt-8 text-3xl font-bold text-slate-900">{r.title}</h1>
        <p class="mt-1 text-slate-500">Valor aproximado del premio: <strong data-usd={(r.prizeValue / 100).toFixed(2)}>{usd(r.prizeValue)}</strong></p>
        <p class="mt-4 whitespace-pre-line text-slate-600">{r.description}</p>

        <!-- Games -->
        <div class="mt-6">
          <h3 class="text-sm font-semibold text-slate-900">Juegos del show</h3>
          <div class="mt-2 flex flex-wrap gap-2">
            {r.games.map((g) => (
              <span
                title={GAME_DESC[g] ?? ""}
                class={`cursor-help rounded-full px-3 py-1 text-xs font-medium ${g === r.finale ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-600"}`}
              >
                {GAME_LABEL[g] ?? g}{g === r.finale ? " · final" : ""}
              </span>
            ))}
          </div>
        </div>

        {r.legacy && (
          <div class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-5">
            <div class="flex items-center gap-2"><Icon name="document" class="h-5 w-5 text-amber-700" /><h3 class="font-semibold text-amber-800">Sorteo histórico</h3></div>
            <p class="mt-2 text-sm text-amber-700">Este sorteo se realizó manualmente <strong>antes</strong> de qori.cc, por eso no tiene semilla ni drand y <strong>no es verificable</strong> provably-fair. Lo mostramos como parte de nuestro historial de premios entregados.</p>
          </div>
        )}
        {!r.legacy && (
        <details class="group mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between">
            <span class="flex items-center gap-2"><Icon name="lock" class="h-5 w-5 text-slate-700" /><h3 class="font-semibold text-slate-900">Transparencia (provably-fair)</h3></span>
            <Icon name="plus" class="h-4 w-4 text-slate-400 transition group-open:rotate-45" />
          </summary>
          <dl class="mt-3 space-y-2 text-sm">
            <div>
              <dt class="text-slate-500">Compromiso de la semilla (publicado al abrir)</dt>
              <dd class="break-all font-mono text-xs text-slate-700">{r.fairness.commitment}</dd>
            </div>
            <div>
              <dt class="text-slate-500">Fuente de azar</dt>
              <dd class="text-slate-700">{r.fairness.entropySource}</dd>
            </div>
            {isDrawn && (
              <>
                <div>
                  <dt class="text-slate-500">Semilla revelada</dt>
                  <dd class="break-all font-mono text-xs text-emerald-700">{r.fairness.serverSeed}</dd>
                </div>
                <div>
                  <dt class="text-slate-500">drand round · valor</dt>
                  <dd class="break-all font-mono text-xs text-slate-700">{r.fairness.drandRound} · {r.fairness.drandValue?.slice(0, 32)}…</dd>
                </div>
              </>
            )}
          </dl>
          <a href={`/verificar?slug=${r.slug}`} class="mt-4 inline-block rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-700">
            {isDrawn ? "Verificar este sorteo" : "Cómo verificar"}
          </a>
        </details>
        )}

        {/* Participants */}
        {participants.length > 0 && (
          <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center gap-2"><Icon name="users" class="h-5 w-5 text-slate-700" /><h3 class="font-semibold text-slate-900">Participantes ({participants.length})</h3></div>
            <p class="mt-1 text-sm text-slate-500">{partTotal} ticket{partTotal === 1 ? "" : "s"} comprado{partTotal === 1 ? "" : "s"} en total.</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {participants.map((p: any) => (
                <a
                  href={p.username ? `/u/${p.username}` : undefined}
                  class={`flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 py-1 pl-1 pr-2.5 ${p.username ? "transition hover:border-emerald-400" : "cursor-default"}`}
                >
                  {p.avatarUrl
                    ? <img src={p.avatarUrl} class="h-7 w-7 rounded-full object-cover" alt="" />
                    : <span class="flex h-7 w-7 items-center justify-center rounded-full bg-slate-200 text-xs font-bold text-slate-500">{(p.nickname || p.username || "?")[0].toUpperCase()}</span>}
                  <span class="max-w-[9rem] truncate text-sm font-medium text-slate-700">{p.nickname || (p.username ? `@${p.username}` : "Anónimo")}</span>
                  <span class="flex items-center gap-0.5 rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700"><img src="/ticket.png" class="h-3 w-3" alt="" />{p.tickets}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {/* Postponement history */}
        {exts.length > 0 && (
          <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5">
            <div class="flex items-center gap-2"><Icon name="refresh" class="h-5 w-5 text-amber-600" /><h3 class="font-semibold text-slate-900">Historial de postergaciones</h3></div>
            <p class="mt-1 text-sm text-slate-500">Cuando no se alcanza el mínimo de tickets, la fecha del sorteo se posterga +24h (hasta 5 veces) para dar más tiempo. Si aun así no se llega, se cancela y se reembolsa todo.</p>
            <ol class="mt-3 space-y-2">
              {exts.map((e, i) => (
                <li class="flex items-start gap-3 rounded-lg bg-slate-50 p-3 text-sm">
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber-100 text-xs font-semibold text-amber-700">{i + 1}</span>
                  <div>
                    <div class="text-slate-700">Postergado a <strong>{fmtLog(e.to)}</strong> (hora Perú)</div>
                    <div class="text-xs text-slate-400">Había {e.ticketCount} de {e.minTickets} tickets mínimos el {fmtLog(e.at)}.</div>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>

      <!-- Right -->
      <div class="lg:sticky lg:top-24 lg:self-start">
        {r.blocked ? (
          <div class="rounded-2xl border border-amber-200 bg-amber-50 p-6">
            <div class="flex items-center gap-2"><Icon name="lock" class="h-5 w-5 text-amber-700" /><h3 class="font-semibold text-amber-800">Sorteo no disponible</h3></div>
            <p class="mt-2 text-sm text-amber-700">Este sorteo está temporalmente desactivado{r.blockReason ? `: ${r.blockReason}` : "."}</p>
            <p class="mt-2 text-xs text-amber-600">Vuelve pronto, se reactivará en cuanto esté listo.</p>
          </div>
        ) : isDrawn ? (
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <h3 class="flex items-center gap-2 text-lg font-bold text-slate-900"><Icon name="trophy" class="h-5 w-5 text-amber-500" /> Ganadores</h3>
            <ul class="mt-4 space-y-3">
              {r.winners?.map((w) => (
                <li class="flex items-center gap-3 rounded-lg bg-slate-50 p-3">
                  {w.avatarUrl && <img src={w.avatarUrl} class="h-10 w-10 rounded-full" alt="" />}
                  <div>
                    <div class="font-semibold text-slate-900">{w.position}º · {w.nickname ?? "Ganador"}</div>
                    <div class="text-xs text-slate-500">Ticket #{w.ticketNumber}</div>
                  </div>
                </li>
              ))}
            </ul>
            {r.legacy
              ? <p class="mt-5 rounded-lg bg-amber-50 px-3 py-2 text-center text-xs text-amber-700">Sorteo histórico (hecho a mano antes de la plataforma).</p>
              : <a href={`/sorteos/${r.slug}/show`} class="mt-5 flex items-center justify-center gap-2 rounded-xl bg-slate-900 px-6 py-3 text-center text-sm font-semibold text-white hover:bg-slate-700"><Icon name="play" class="h-4 w-4" /> Ver el show</a>}
          </div>
        ) : (
          <div class="space-y-4">
            <div class="rounded-2xl border border-slate-200 bg-white p-5">
              <div class="mb-1.5 flex justify-between text-sm text-slate-500">
                <span id="rf-sold" data-sold={sold} data-total={r.totalTickets} data-live-sold={r.slug} data-live-total={r.totalTickets}>{sold} / {r.totalTickets} tickets</span>
                <span class="flex items-center gap-1 font-medium text-slate-700"><Icon name="clock" class="h-4 w-4" /> <span data-closes-at={r.closesAt}>{timeLeft(r.closesAt)}</span></span>
              </div>
              <div class="h-2.5 overflow-hidden rounded-full bg-slate-100">
                <div id="rf-fill" class="h-full rounded-full bg-emerald-500 transition-all" data-live-fill={r.slug} data-live-total={r.totalTickets} style={`width:${pct(sold, r.totalTickets)}%`}></div>
              </div>
              <p class="mt-2 text-xs text-slate-400">Mínimo {r.minTickets} tickets para sortear. Si no se alcanza, se reembolsa.</p>
              {(r.extensionCount ?? 0) > 0 && (
                <p class="mt-2 flex items-start gap-2 rounded-lg bg-amber-50 px-3 py-2 text-xs text-amber-700">
                  <Icon name="refresh" class="mt-0.5 h-4 w-4" />
                  <span>Postergado {r.extensionCount} vez{(r.extensionCount ?? 0) > 1 ? "ces" : ""} +24h para alcanzar el mínimo de tickets. Nueva fecha: <strong>{r.closesAt ? new Date(r.closesAt).toLocaleString("es-PE", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" }) : ""}</strong>.</span>
                </p>
              )}
            </div>

            {/* Draw time across LatAm timezones */}
            {r.closesAt && (
              <div class="rounded-2xl border border-slate-200 bg-white p-5">
                <div class="flex items-center gap-2"><Icon name="clock" class="h-5 w-5 text-slate-700" /><h3 class="text-sm font-semibold text-slate-900">Hora del sorteo en tu país</h3></div>
                <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2">
                  {ZONES.map((z) => (
                    <li class="flex items-center gap-2 text-sm">
                      <img src={`/flags/${z.cc}.svg`} alt={z.name} width="20" height="15" class="h-[15px] w-5 shrink-0 rounded-sm border border-slate-200 object-cover" />
                      <div class="min-w-0">
                        <div class="truncate text-xs text-slate-500">{z.name}</div>
                        <div class="truncate text-xs font-medium text-slate-800">{zoneTime(r.closesAt, z.tz)}</div>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {isOpen && <BuyWidget client:load slug={r.slug} ticketPrice={r.ticketPrice} maxPerUser={r.maxTicketsPerUser} />}
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
