---
import Layout from "../../layouts/Layout.astro";
import RaffleCard from "../../components/RaffleCard.astro";
import { ssrGet, type Raffle } from "../../lib/api";

const raffles = await ssrGet<Raffle[]>("/raffles", []);
const active = raffles.filter((r) => r.status === "OPEN" || r.status === "CLOSED" || r.status === "DRAWING");
// Finished raffles: most recent draw first.
const past = raffles
  .filter((r) => r.status === "DRAWN" || r.status === "CANCELLED")
  .sort((a, b) => new Date(b.drawnAt ?? b.closesAt ?? 0).getTime() - new Date(a.drawnAt ?? a.closesAt ?? 0).getTime());
---

<Layout title="Sorteos · qori" description="Todos los sorteos activos y finalizados de qori. Elige tu premio, compra tu ticket con número único y mira el sorteo en vivo.">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <h1 class="text-3xl font-bold text-slate-900">Sorteos</h1>
    <p class="mt-2 text-slate-500">Elige un sorteo y participa. Todos son verificables.</p>

    <h2 class="mb-6 mt-10 text-xl font-bold text-slate-900">Activos <span class="text-slate-500">({active.length})</span></h2>
    {active.length === 0 ? (
      <p class="rounded-xl border border-dashed border-slate-200 p-10 text-center text-slate-500">No hay sorteos activos.</p>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {active.map((r) => <RaffleCard raffle={r} />)}
      </div>
    )}

    {past.length > 0 && (
      <>
        <h2 class="mb-6 mt-14 text-xl font-bold text-slate-900">Finalizados <span class="text-slate-500">({past.length})</span></h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {past.map((r) => <RaffleCard raffle={r} />)}
        </div>
      </>
    )}
  </div>
</Layout>
