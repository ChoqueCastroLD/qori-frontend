---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Página no encontrada · qori">
  <div class="mx-auto flex max-w-xl flex-col items-center px-5 py-28 text-center">
    <div class="text-6xl font-bold text-emerald-500">404</div>
    <h1 class="mt-4 text-2xl font-bold text-slate-900">Esta página no existe</h1>
    <p class="mt-2 text-slate-500">El enlace puede estar roto o el sorteo ya no está disponible.</p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="rounded-xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white hover:bg-slate-700">Ir al inicio</a>
      <a href="/sorteos" class="rounded-xl border border-slate-200 px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">Ver sorteos</a>
    </div>
  </div>
</Layout>
