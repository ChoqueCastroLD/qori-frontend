---
import "../styles/global.css";
import Nav from "../components/Nav.tsx";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title = "qori | Sorteos de productos transparentes y verificables",
  description = "Participa en sorteos de productos con premios reales en LatAm. Compra tickets con lingotes, mira el sorteo en vivo y revisa el resultado tú mismo.",
  image = "/og.png",
  noindex = false,
} = Astro.props;

const SITE = "https://qori.cc";
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImage = new URL(image, SITE).href;
const altLocales = ["es_MX", "es_CO", "es_CL", "es_AR", "es_EC", "es_BO"];
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#10b981" />
    <meta name="author" content="qori.cc" />
    <meta name="keywords" content="sorteos, sorteos online, rifas, sorteos verificables, provably-fair, sorteos LatAm, sorteos Perú, sorteos México, premios, tickets, ganar premios" />

    <!-- Idioma -->
    <meta http-equiv="content-language" content="es" />
    <link rel="alternate" hreflang="es" href={SITE} />
    <link rel="alternate" hreflang="x-default" href={SITE} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="qori" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_PE" />
    {altLocales.map((l) => <meta property="og:locale:alternate" content={l} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
  </head>
  <body class="flex min-h-full flex-col bg-white text-slate-900 antialiased">
    <header class="sticky top-0 z-40 border-b border-slate-100 bg-white/90 backdrop-blur">
      <nav class="relative mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-5 sm:py-3.5">
        <div class="flex items-center gap-1.5">
          <button id="menu-btn" type="button" aria-label="Menú" aria-expanded="false" class="-ml-1 flex h-9 w-9 items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 md:hidden">
            <svg class="menu-open h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            <svg class="menu-close hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M6 18 18 6"/></svg>
          </button>
          <a href="/" class="flex items-center gap-2 text-xl font-bold tracking-tight text-slate-900">
            <img src="/logo.png" alt="qori" class="h-7 w-7" style="image-rendering:pixelated" />qori
          </a>
        </div>
        <div class="absolute left-1/2 top-1/2 hidden -translate-x-1/2 -translate-y-1/2 items-center gap-6 text-sm font-medium text-slate-600 md:flex">
          <a href="/sorteos" class="hover:text-slate-900">Sorteos</a>
          <a href="/ganadores" class="hover:text-slate-900">Ganadores</a>
          <a href="/como-funciona" class="hover:text-slate-900">Cómo funciona</a>
          <a href="/verificar" class="hover:text-slate-900">Verificar</a>
        </div>
        <Nav client:load />
      </nav>
      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white md:hidden">
        <div class="mx-auto max-w-6xl px-2 py-2">
          <a href="/sorteos" class="block rounded-lg px-3 py-3 text-base font-medium text-slate-700 hover:bg-slate-50">Sorteos</a>
          <a href="/ganadores" class="block rounded-lg px-3 py-3 text-base font-medium text-slate-700 hover:bg-slate-50">Ganadores</a>
          <a href="/como-funciona" class="block rounded-lg px-3 py-3 text-base font-medium text-slate-700 hover:bg-slate-50">Cómo funciona</a>
          <a href="/verificar" class="block rounded-lg px-3 py-3 text-base font-medium text-slate-700 hover:bg-slate-50">Verificar</a>
        </div>
      </div>
    </header>
    <script is:inline>
      (function () {
        var btn = document.getElementById("menu-btn");
        var menu = document.getElementById("mobile-menu");
        if (!btn || !menu) return;
        var open = btn.querySelector(".menu-open"), close = btn.querySelector(".menu-close");
        function set(v) {
          menu.classList.toggle("hidden", !v);
          if (open) open.classList.toggle("hidden", v);
          if (close) close.classList.toggle("hidden", !v);
          btn.setAttribute("aria-expanded", v ? "true" : "false");
          document.body.classList.toggle("overflow-hidden", v);
        }
        btn.addEventListener("click", function () { set(menu.classList.contains("hidden")); });
        menu.querySelectorAll("a").forEach(function (a) { a.addEventListener("click", function () { set(false); }); });
        window.addEventListener("resize", function () { if (window.innerWidth >= 768) set(false); });
      })();
    </script>

    <main class="flex-1">
      <slot />
    </main>

    <script is:inline>
      // Live countdown: refresh every element with data-closes-at every 30s.
      (function () {
        function fmt(iso) {
          var ms = new Date(iso).getTime() - Date.now();
          if (ms <= 0) return "Cerrado";
          var d = Math.floor(ms / 86400000), h = Math.floor((ms % 86400000) / 3600000), m = Math.floor((ms % 3600000) / 60000);
          if (d > 0) return d + "d " + h + "h";
          if (h > 0) return h + "h " + m + "m";
          return m + "m";
        }
        function tick() {
          document.querySelectorAll("[data-closes-at]").forEach(function (el) {
            var iso = el.getAttribute("data-closes-at");
            if (iso) el.textContent = fmt(iso);
          });
        }
        tick();
        setInterval(tick, 30000);
      })();
    </script>

    <script is:inline>
      // Indicative local-currency reference next to USD prices ([data-usd] = USD).
      (function () {
        var CUR = { PE:{code:"PEN",sym:"S/",loc:"es-PE"}, MX:{code:"MXN",sym:"MX$",loc:"es-MX"},
          CO:{code:"COP",sym:"COL$",loc:"es-CO"}, CL:{code:"CLP",sym:"CLP$",loc:"es-CL"}, AR:{code:"ARS",sym:"AR$",loc:"es-AR"} };
        Promise.all([
          fetch("/api/fx").then(function(r){return r.json()}).catch(function(){return null}),
          fetch("/api/auth/me",{credentials:"include"}).then(function(r){return r.ok?r.json():null}).catch(function(){return null})
        ]).then(function(res){
          var fx=res[0], me=res[1];
          if(!fx||!fx.rates) return;
          var c=CUR[(me&&me.user&&me.user.country)||"PE"]||CUR.PE;
          var rate=fx.rates[c.code]; if(!rate) return;
          document.querySelectorAll("[data-usd]").forEach(function(el){
            var usd=parseFloat(el.getAttribute("data-usd")); if(isNaN(usd)) return;
            var v=usd*rate;
            var s=document.createElement("span");
            s.className="text-slate-400";
            s.textContent=" · aprox "+c.sym+" "+new Intl.NumberFormat(c.loc,{maximumFractionDigits:0}).format(v);
            el.appendChild(s);
          });
        });
      })();
    </script>

    <footer class="mt-24 border-t border-slate-100 bg-slate-50">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 sm:grid-cols-2 md:grid-cols-4">
        <div>
          <div class="flex items-center gap-2 text-lg font-bold">
            <img src="/logo.png" alt="qori" class="h-6 w-6" style="image-rendering:pixelated" />qori
          </div>
          <p class="mt-3 text-sm text-slate-500">Tu ticket, tu número, tu premio. Sorteos en vivo para toda Latinoamérica.</p>
          <p class="mt-3 text-sm text-slate-500"><a href="mailto:support@qori.cc" class="font-medium text-emerald-600 hover:underline">support@qori.cc</a> · Atención 24/7</p>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Sorteos</h3>
          <ul class="mt-3 space-y-2 text-sm text-slate-500">
            <li><a href="/sorteos" class="hover:text-slate-900">Ver todos</a></li>
            <li><a href="/ganadores" class="hover:text-slate-900">Ganadores</a></li>
            <li><a href="/como-funciona" class="hover:text-slate-900">Cómo funciona</a></li>
            <li><a href="/verificar" class="hover:text-slate-900">Verificar sorteo</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Legal</h3>
          <ul class="mt-3 space-y-2 text-sm text-slate-500">
            <li><a href="/legal/terminos" class="hover:text-slate-900">Términos y condiciones</a></li>
            <li><a href="/legal/bases" class="hover:text-slate-900">Bases de cada sorteo</a></li>
            <li><a href="/legal/privacidad" class="hover:text-slate-900">Privacidad</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Sobre la verificación</h3>
          <p class="mt-3 text-sm text-slate-500">Cada sorteo publica sus reglas antes de venderse y todos sus datos al terminar. Puedes repetir cualquier resultado desde la página del sorteo.</p>
        </div>
      </div>
      <div class="border-t border-slate-100 py-6 text-center text-xs text-slate-400">
        © 2026 qori.cc · Solo mayores de 18 años · Juega con responsabilidad
      </div>
    </footer>
  </body>
</html>
